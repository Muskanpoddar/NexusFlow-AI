
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusflow_db
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-at-least-32-characters-long

# Password reset
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Mail delivery for password reset links (Resend). Without a key the link
# is written to the server log instead.
RESEND_API_KEY=
RESEND_FROM=NexusFlow <onboarding@resend.dev>

# AI provider (MiniMax)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_API_URL=https://api.minimax.io/v1
