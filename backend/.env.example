
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusflow_db
PORT=5000
NODE_ENV=development
# A comma separated list allows more than one frontend origin
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-at-least-32-characters-long
JWT_EXPIRES_IN=15m

# Links in the mails we send
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
INVITATION_TTL_HOURS=72

# Mail delivery for password reset and invitation links (Resend). Without a
# key the link is written to the server log instead.
RESEND_API_KEY=
RESEND_FROM=NexusFlow <onboarding@resend.dev>

# AI provider (Anthropic). Without a key the assistant answers from the
# workspace snapshot instead of calling the model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_URL=https://api.anthropic.com
